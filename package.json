{
  "name": "solaragent-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "drizzle-kit generate --config apps/backend/drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config apps/backend/drizzle.config.ts",
    "migrate:shop": "tsx apps/backend/src/db/migrate-shop.ts",
    "seed": "tsx apps/backend/src/db/seed.ts",
    "seed:marketplace": "tsx apps/backend/src/db/seed-marketplace.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p apps/backend/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspace apps/backend && npm run build --workspace apps/web",
    "vercel-build": "npm run build --workspace @solaragent/web",
    "db:setup": "npm run migrate && npm run migrate:shop && npm run seed && npm run seed:marketplace",
    "dev": "concurrently \"npm run dev --workspace apps/backend\" \"npm run dev --workspace apps/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
