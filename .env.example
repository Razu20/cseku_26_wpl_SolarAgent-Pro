NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret

# URL of the separately hosted backend. The frontend appends /api/v1 when needed.
VITE_API_URL=https://your-backend.example.com

# Frontend URL used by backend redirects.
FRONTEND_URL=https://your-frontend.vercel.app

# Backend public URL used by payment callbacks.
PUBLIC_API_URL=https://your-backend.example.com

# Required for SSLCommerz payment callbacks
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
