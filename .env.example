NODE_ENV=development
# Hosted PostgreSQL: keep certificate verification enabled.
DATABASE_URL=postgresql://user:password@host:5432/solaragent?sslmode=verify-full
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_URL=http://localhost:3000

# Optional payment provider. Use your public HTTPS APP_URL when deploying.
# PUBLIC_API_URL and FRONTEND_URL are optional overrides for provider callbacks.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
# Local development only; never accepted in production.
PAYMENT_SIMULATOR_ENABLED=false

# Optional transactional email provider.
RESEND_API_KEY=
EMAIL_FROM=SolarAgent Pro <orders@example.com>
